{
  "name": "chronicle",
  "productName": "Chronicle",
  "version": "0.5.0",
  "private": true,
  "description": "Visual Git history editor for macOS, Windows and Linux",
  "homepage": "https://github.com/betrayalove/git-gui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betrayalove/git-gui.git"
  },
  "bugs": "https://github.com/betrayalove/git-gui/issues",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:win:zip": "electron-vite build && electron-builder --win zip --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "icon": "electron-vite build && node --experimental-strip-types scripts/render-icon.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "author": "betrayalove",
  "build": {
    "appId": "com.betrayalove.chronicle",
    "productName": "Chronicle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Chronicle-${version}-macos-${arch}-portable.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Chronicle-${version}-windows-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Chronicle-${version}-windows-${arch}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "Chronicle-${version}-macos-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Chronicle-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "betrayalove <50327133+betrayalove@users.noreply.github.com>",
      "synopsis": "Visual Git history editor",
      "artifactName": "Chronicle-${version}-linux-x64-portable.${ext}"
    },
    "appImage": {
      "artifactName": "Chronicle-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Chronicle-${version}-linux-x64.${ext}",
      "depends": [
        "git",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
